@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/> .
@prefix this: <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    sub:decl npx:declaredBy sub:consilience-engine ;
        npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" .

    sub:consilience-engine a npx:SoftwareAgent,
            npx:SoftwareTool ;
        frbr:owner orcid:0009-0008-3375-7858 ;
        foaf:name "The Consilience engine" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo orcid:0009-0008-3375-7858 .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy sub:consilience-engine .

    orcid:0009-0008-3375-7858 foaf:name "Anuja Khatri" .

    this: rdfs:label "The Consilience engine" ;
        dcterms:created "2026-11-18T14:37:36+00:00"^^xsd:dateTime ;
        dcterms:creator sub:consilience-engine ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType npx:declaredBy ;
        npx:introduces sub:consilience-engine ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAbn04KkfbV5PK2UDGkp-j7RUghs_y75DL4qWl_8zQQ3w> .
}

