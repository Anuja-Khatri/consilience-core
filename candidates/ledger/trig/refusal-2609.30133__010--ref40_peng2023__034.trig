sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__010|ref40_peng2023__034" ;
        cv:axis "overpotential_stability" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L271-L309> ;
        cv:claimASentence "InMnPdOx is the most stable, sustaining an overpotential below 0.5 V over 1,000 h (repeated measurements over a partial duration on planar and porous supports are shown in Figs. S4 – S6)." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1185-L1224> ;
        cv:claimBSentence "The overpotential at a current density of 10 mA cm–2 decreases dramatically from 348 mV for Pd-25 to 280 mV for Pd-40, and Pd-55 displays the best OER catalytic activity with an ultralow overpotential of 196 mV, which surpasses that of commercial IrO2 and Pd/C (Fig. 3c)." ;
        cv:hasDefect sub:defect ;
        cv:outcome cv:AxisMismatch .

    sub:defect cv:defectTarget "overpotential_stability vs overpotential_at_current_density" ;
        cv:defectType cv:AxisMismatch .
}

