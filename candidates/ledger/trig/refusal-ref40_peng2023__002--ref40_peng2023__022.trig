sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "ref40_peng2023__002|ref40_peng2023__022" ;
        cv:axis "operational_stability_duration" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L623-L668> ;
        cv:claimASentence "After 500 h of testing at 10 mA cm–2, Pd-55 shows superior stability with little decay in 1 M HClO4." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1024-L1069> ;
        cv:claimBSentence "Pd-55 with particle size that has been shrunk to 2.8 nm exhibits optimal performance, where the overpotential at 10 mA cm–2 can decrease to 196 mV and the durability reaches up to 500 h in 1 M HClO4." ;
        cv:hasDefect sub:defect ;
        cv:outcome cv:AxisMismatch .

    sub:defect cv:defectTarget "operational_stability_duration vs overpotential_at_current_density" ;
        cv:defectType cv:AxisMismatch .
}

