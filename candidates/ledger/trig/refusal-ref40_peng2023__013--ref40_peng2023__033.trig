sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "ref40_peng2023__013|ref40_peng2023__033" ;
        cv:axis "overpotential_at_current_density" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L867-L902> ;
        cv:claimASentence "In contrast, the PdCoO2 precursors without etching display poor catalytic activity with an overpotential of 528 mV (Supplementary Fig. S9b)." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1145-L1184> ;
        cv:claimBSentence "The overpotential at a current density of 10 mA cm–2 decreases dramatically from 348 mV for Pd-25 to 280 mV for Pd-40, and Pd-55 displays the best OER catalytic activity with an ultralow overpotential of 196 mV, which surpasses that of commercial IrO2 and Pd/C (Fig. 3c)." ;
        cv:hasDefect sub:defect,
            sub:defect__1,
            sub:defect__2,
            sub:defect__3 ;
        cv:outcome cv:NotComparable .

    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "current_density" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__2 cv:defectTarget "temperature" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__3 cv:defectTarget "ir_correction" ;
        cv:defectType cv:ConditionUnstated .
}

