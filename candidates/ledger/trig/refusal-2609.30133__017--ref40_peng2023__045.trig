sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__017|ref40_peng2023__045" ;
        cv:axis "overpotential_reproducibility_between_film_formats" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L427-L462> ;
        cv:claimASentence "Screening the uniform films by SEC reproduced the overpotentials of their combinatorial (gradient) counterparts within 15 mV (Fig. S 3)." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1304-L1339> ;
        cv:claimBSentence "The transmission electron microscopy (TEM) statistic results reveal that the size decreases rapidly and gradually stabilizes to ∼3 nm (Fig. 1f) when heating to above room temperature." ;
        cv:hasDefect sub:defect ;
        cv:outcome cv:AxisMismatch .

    sub:defect cv:defectTarget "overpotential_reproducibility_between_film_formats vs particle_size_stabilization" ;
        cv:defectType cv:AxisMismatch .
}

