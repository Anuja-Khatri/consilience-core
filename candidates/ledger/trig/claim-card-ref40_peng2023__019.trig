@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L903-L941> a cv:ClaimCard ;
        dct:identifier "ref40_peng2023__019" ;
        dct:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "tafel_slope" ;
        cv:claimKind "performance_value" ;
        cv:conditionUnstated "current_density",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasCondition sub:condition ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "tafel_analysis" ;
        cv:objectName "tafel_slope" ;
        cv:relation "has_tafel_slope" ;
        cv:sourceSentence "Moreover, from Fig. 3b, the Pd catalyst prepared at 55°C exhibits the best kinetics with a Tafel slope of 51.3 mV dec–1, which outperforms hierarchical Pd at a lower etching temperature and the benchmark IrO2 catalyst." ;
        cv:subjectName "Pd-55" .

    sub:condition cv:conditionName "anneal_temperature" ;
        cv:conditionValueJson "{\"unit\": \"degC\", \"value\": 55.0}" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "mV/decade" ;
        schema:value 51.3 ;
        cv:bound "exact" .
}

