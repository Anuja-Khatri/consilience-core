@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L784-L826> a cv:ClaimCard ;
        dct:identifier "ref40_peng2023__010" ;
        dct:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "cell_voltage_at_current_density" ;
        cv:claimKind "performance_value" ;
        cv:conditionUnstated "anneal_temperature",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate" ;
        cv:hasCondition sub:condition,
            sub:condition__1 ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "polarization_curve" ;
        cv:objectName "cell_voltage" ;
        cv:relation "has_cell_voltage_at_current_density" ;
        cv:sourceSentence "From the polarization curves at 65°C in Fig. 5b and Supplementary Figs S16 and S17, a voltage of only 1.664 and 1.771 V is required to achieve 1 and 2 A cm–2, respectively, demonstrating superior performance for acidic water electrolysis [10,42]." ;
        cv:subjectName "PEM electrolyser with Pd-55 (2 mg cm–2) as both cathode and anode catalysts" .

    sub:condition cv:conditionName "current_density" ;
        cv:conditionValueJson "{\"normalization\": \"geometric\", \"unit\": \"A/cm^2\", \"value\": 2.0}" .

    sub:condition__1 cv:conditionName "temperature" ;
        cv:conditionValueJson "{\"unit\": \"degC\", \"value\": 65.0}" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "V" ;
        schema:value 1.771 ;
        cv:bound "exact" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L784-L826> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "234ae55fc3fd6105a94ff9b6dc9074f771d60ca789cea9bc771c36e460e07f4b" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "card-sha256-v0" ;
        cv:ledgerHash "a11ee946669360b4327e2dd22391b2711cbba60c15e9f1f447286351abe69bdd" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

