sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "ref40_peng2023__019|ref40_peng2023__025" ;
        cv:axis "tafel_slope" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L903-L941> ;
        cv:claimASentence "Moreover, from Fig. 3b, the Pd catalyst prepared at 55°C exhibits the best kinetics with a Tafel slope of 51.3 mV dec–1, which outperforms hierarchical Pd at a lower etching temperature and the benchmark IrO2 catalyst." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1070-L1108> ;
        cv:claimBSentence "Prominently, the mass dissolution rate for Pd-55 was 0.14 ng cm–2 s–1 during 500-h test." ;
        cv:hasDefect sub:defect ;
        cv:outcome cv:AxisMismatch .

    sub:defect cv:defectTarget "tafel_slope vs mass_dissolution_rate" ;
        cv:defectType cv:AxisMismatch .
}

