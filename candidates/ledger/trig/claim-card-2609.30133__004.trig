@prefix cv: <https://theconsilience.io/ns/cv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L120-L159> a cv:ClaimCard ;
        dct:identifier "2609.30133__004" ;
        dct:source <https://arxiv.org/abs/2609.30133> ;
        cv:axis "overpotential_at_current_density" ;
        cv:claimKind "performance_value" ;
        cv:conditionUnstated "anneal_temperature",
            "electrolyte",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasCondition sub:condition,
            sub:condition__1 ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "cp_chronopotentiometry" ;
        cv:objectName "overpotential" ;
        cv:relation "has_overpotential" ;
        cv:sourceSentence "During the initial 10 mA cm-2 hold, InMnPdOx held a stable overpotential of 0.45 V (not iR-corrected), within 40 mV of RuOx (0.41 V) and roughly 90 mV below the best non-PGM catalyst." ;
        cv:subjectName "RuOx" .

    sub:condition cv:conditionName "current_density" ;
        cv:conditionValueJson "{\"normalization\": \"geometric\", \"unit\": \"mA/cm^2\", \"value\": 10.0}" .

    sub:condition__1 cv:conditionName "ir_correction" ;
        cv:conditionValueJson "false" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "V" ;
        schema:value 0.41 ;
        cv:bound "exact" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L120-L159> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "d193bf09acd503c14ad66813bf7322dea3563930fa042e65bb575080421252d3" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "card-sha256-v0" ;
        cv:ledgerHash "a11ee946669360b4327e2dd22391b2711cbba60c15e9f1f447286351abe69bdd" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:pubinfo {
    sub: rdfs:label "Claim card 2609.30133__004: RuOx, overpotential_at_current_density 0.41 V" ;
        dct:created "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:ClaimCard ;
        nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAjkzVXYgeEW-ORY5ZYAa_l_mgd-3Ki7HFItomg2I8el4/templateVersion> ;
        nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        nt:wasCreatedFromTemplate <https://w3id.org/np/RAeUz0d9B-nQjoyXJQwXNJKx5gyD6li8FOjfFcKBzq5f8/templateVersion> .
}

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

