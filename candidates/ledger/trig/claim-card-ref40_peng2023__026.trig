sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1109-L1144> a cv:ClaimCard ;
        dct:identifier "ref40_peng2023__026" ;
        dct:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "mass_activity" ;
        cv:claimKind "performance_value" ;
        cv:conditionUnstated "anneal_temperature",
            "current_density",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "cv_or_lsv" ;
        cv:objectName "mass activity" ;
        cv:relation "has_mass_activity" ;
        cv:sourceSentence "Prominently, the OER performance of the Pd catalyst is dramatically enhanced and exhibits an ultralow overpotential of 196 mV at 10 mA cm–2 and high mass activity of 407.2 A g–1 at 1.53 VRHE (RHE, reversible hydrogen electrode) in 1 M HClO4 when the size shrinks to ∼2.8 nm." ;
        cv:subjectName "hierarchical Pd catalyst" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "A/g" ;
        schema:value 407.2 ;
        cv:bound "exact" .
}

