@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__005|2609.30133__013" ;
        cv:axis "Pd_retention" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L160-L198> ;
        cv:claimASentence "From XRF results, InMnPdOx retains 96% of its Pd after 1,000 h, a marked improvement in corrosion stability over the other systems." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L349-L387> ;
        cv:claimBSentence "NiTaPdOx retains 88% Pd after 575 h, PdOx retains 87% Pd after 828 h, and RuOx retains 59% Ru after 661 h of operation (Fig. S7)." ;
        cv:hasDefect sub:defect,
            sub:defect__1,
            sub:defect__2,
            sub:defect__3 ;
        cv:outcome cv:NotComparable .

    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "current_density" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__2 cv:defectTarget "temperature" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__3 cv:defectTarget "ir_correction" ;
        cv:defectType cv:ConditionUnstated .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/rejections.json#L3140-L3174> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "1b2b464262ee3034f95b3157ac18913c48334e43bc4d2f6438bca72e22d809e8" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

