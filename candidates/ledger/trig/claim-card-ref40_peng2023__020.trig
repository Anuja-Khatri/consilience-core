sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L942-L977> a cv:ClaimCard ;
        dct:identifier "ref40_peng2023__020" ;
        dct:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "mass_activity_at_overpotential" ;
        cv:claimKind "performance_value" ;
        cv:conditionUnstated "anneal_temperature",
            "current_density",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "lsv_or_cv_mass_normalized" ;
        cv:objectName "mass_activity" ;
        cv:relation "has_mass_activity" ;
        cv:sourceSentence "Pd-25 has a similar mass activity (MA) of 3.7 A g–1 to 3.2 A g–1 for commercial Pd/C." ;
        cv:subjectName "Pd-25" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "A g^-1" ;
        schema:value 3.7 ;
        cv:bound "exact" .
}

