sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1070-L1108> a cv:ClaimCard ;
        dct:identifier "ref40_peng2023__025" ;
        dct:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "mass_dissolution_rate" ;
        cv:claimKind "stability_value" ;
        cv:conditionUnstated "anneal_temperature",
            "current_density",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasCondition sub:condition ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "icp_ms_dissolution" ;
        cv:objectName "mass_dissolution_rate" ;
        cv:relation "has_mass_dissolution_rate" ;
        cv:sourceSentence "Prominently, the mass dissolution rate for Pd-55 was 0.14 ng cm–2 s–1 during 500-h test." ;
        cv:subjectName "Pd-55" .

    sub:condition cv:conditionName "prior_operation_duration" ;
        cv:conditionValueJson "{\"unit\": \"h\", \"value\": 500.0}" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "ng cm^-2 s^-1" ;
        schema:value 0.14 ;
        cv:bound "exact" .
}

