@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__020|2609.30133__023" ;
        cv:axis "overpotential_at_current_density" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L463-L502> ;
        cv:claimASentence "The most active were consistently Co-rich and Zr-containing, clustering near Co78In12Zr10Ox and Co86Fe7Zr7Ox (CoInZrOx and CoFeZrOx), reaching 0.55 V at 10 mA cm-2." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L543-L582> ;
        cv:claimBSentence "Two material systems stand out in the Pareto front, which are defined by Pd-rich, non-annealed compositions with either In-Mn or Ni-Ta as additives, reaching overpotentials below 0.46 V at 10 mA cm-2 with 0.3–0.7 µmol cm-2 loss (~60–75% molar retention after screening)." ;
        cv:hasDefect sub:defect,
            sub:defect__1,
            sub:defect__2 ;
        cv:outcome cv:NotComparable .

    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "temperature" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__2 cv:defectTarget "ir_correction" ;
        cv:defectType cv:ConditionUnstated .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/rejections.json#L7807-L7837> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "3840fa8253dd4eba66fb63a34be5cddca1f03e174910b7a70aa81d3889aecfb7" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

