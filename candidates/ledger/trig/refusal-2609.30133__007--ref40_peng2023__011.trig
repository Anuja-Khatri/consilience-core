sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__007|ref40_peng2023__011" ;
        cv:axis "stability_lifetime" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L235-L270> ;
        cv:claimASentence "However, both failed medium-term acidic stability screening, with lifetimes under 4 h (Fig. S1)." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L827-L866> ;
        cv:claimBSentence "Furthermore, the high durability of >40 h for Pd-55 at 100 mA cm–2 also confirms that hierarchical Pd is quite stable under a large current density." ;
        cv:hasDefect sub:defect ;
        cv:outcome cv:AxisMismatch .

    sub:defect cv:defectTarget "stability_lifetime vs operational_stability_duration" ;
        cv:defectType cv:AxisMismatch .
}

