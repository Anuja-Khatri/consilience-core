@prefix cv: <https://theconsilience.io/ns/cv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__003|2609.30133__004" ;
        cv:axis "overpotential_at_current_density" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L80-L119> ;
        cv:claimASentence "During the initial 10 mA cm-2 hold, InMnPdOx held a stable overpotential of 0.45 V (not iR-corrected), within 40 mV of RuOx (0.41 V) and roughly 90 mV below the best non-PGM catalyst." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L120-L159> ;
        cv:claimBSentence "During the initial 10 mA cm-2 hold, InMnPdOx held a stable overpotential of 0.45 V (not iR-corrected), within 40 mV of RuOx (0.41 V) and roughly 90 mV below the best non-PGM catalyst." ;
        cv:hasDefect sub:defect,
            sub:defect__1 ;
        cv:outcome cv:NotComparable .

    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "temperature" ;
        cv:defectType cv:ConditionUnstated .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/rejections.json#L1509-L1535> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "6beed11de5b2ad531136ec790c18f8ac9860aee2af64326fd2720336775e9d68" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

