    sub: rdfs:label "Claim card ref40_peng2023__040: hierarchical Pd catalyst, degradation_rate_at_current_density 66.0 uV/h" ;
        dct:created "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
