@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L1185-L1224> a cv:ClaimCard ;
        dct:identifier "ref40_peng2023__034" ;
        dct:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "overpotential_at_current_density" ;
        cv:claimKind "performance_value" ;
        cv:conditionUnstated "anneal_temperature",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasCondition sub:condition ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "cp_chronopotentiometry" ;
        cv:objectName "overpotential" ;
        cv:relation "has_overpotential" ;
        cv:sourceSentence "The overpotential at a current density of 10 mA cm–2 decreases dramatically from 348 mV for Pd-25 to 280 mV for Pd-40, and Pd-55 displays the best OER catalytic activity with an ultralow overpotential of 196 mV, which surpasses that of commercial IrO2 and Pd/C (Fig. 3c)." ;
        cv:subjectName "Pd-40" .

    sub:condition cv:conditionName "current_density" ;
        cv:conditionValueJson "{\"normalization\": \"geometric\", \"unit\": \"mA/cm^2\", \"value\": 10.0}" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "mV" ;
        schema:value 280.0 ;
        cv:bound "exact" .
}

