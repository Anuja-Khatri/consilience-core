sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dct:identifier "2609.30133__001|ref40_peng2023__006" ;
        cv:axis "hours_to_threshold" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L2-L40> ;
        cv:claimASentence "During long-term testing, NiTaPdOx operated at lower overpotential than PdOx, but both eventually exceeded 0.5 V: PdOx at ~200 h and NiTaPdOx at ~470 h." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L705-L740> ;
        cv:claimBSentence "Consequently, the strong oxygen binding results in an ultra-high energy barrier of ΔG3 (2.79 eV, ΔGHOO*−ΔGO*) despite HOO* having a normal adsorption energy, and the potential determining steps (PDS) for the Pd catalyst are between HOO* and O*." ;
        cv:hasDefect sub:defect ;
        cv:outcome cv:AxisMismatch .

    sub:defect cv:defectTarget "hours_to_threshold vs reaction_free_energy_barrier" ;
        cv:defectType cv:AxisMismatch .
}

