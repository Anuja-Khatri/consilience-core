@prefix cv: <https://theconsilience.io/ns/cv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAttErMNFCCmfeggou4vaaXQlqbePSCw3Rh_qigiFSpa4/> .
@prefix this: <https://w3id.org/np/RAttErMNFCCmfeggou4vaaXQlqbePSCw3Rh_qigiFSpa4> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "ref40_peng2023__002|ref40_peng2023__011" ;
        cv:axis "operational_stability_duration" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L623-L668> ;
        cv:claimASentence "After 500 h of testing at 10 mA cm–2, Pd-55 shows superior stability with little decay in 1 M HClO4." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L827-L866> ;
        cv:claimBSentence "Furthermore, the high durability of >40 h for Pd-55 at 100 mA cm–2 also confirms that hierarchical Pd is quite stable under a large current density." ;
        cv:hasDefect sub:defect,
            sub:defect__1,
            sub:defect__2,
            sub:defect__3 ;
        cv:outcome cv:NotComparable .

    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "CR2" ;
        cv:defectType cv:ConditionMismatch .

    sub:defect__2 cv:defectTarget "temperature" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__3 cv:defectTarget "ir_correction" ;
        cv:defectType cv:ConditionUnstated .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/rejections.json#L9794-L9828> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "5a2b525959bd603a19e715ef1ad7a3f0d90b5534cba344c89a2b326a8ae2e059" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> .

    this: rdfs:label "Comparison refused, ref40_peng2023__002 vs ref40_peng2023__011: current_density differs (rule CR2); not stated: electrolyte, temperature, ir_correction" ;
        dcterms:created "2026-11-16T19:28:48+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:ComparisonRefusal ;
        npx:introduces sub:refusal ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAjkzVXYgeEW-ORY5ZYAa_l_mgd-3Ki7HFItomg2I8el4/templateVersion> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAr2wiuk3YGzyw123e9k0lc-c8Om_WRhv5zQEyP6Rz9Dw/templateVersion> .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

