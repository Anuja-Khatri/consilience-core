@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAce-1rCNfSZ2iEgvtyEsbmD--7JqbSx6ya0pa7-sVcWY/> .
@prefix this: <https://w3id.org/np/RAce-1rCNfSZ2iEgvtyEsbmD--7JqbSx6ya0pa7-sVcWY> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Comparison refused, ref40_peng2023__002 vs ref40_peng2023__011: current density differs (10 vs 100 mA/cm², rule CR2); not stated in claim B: electrolyte; not stated in either claim: temperature, iR correction" ;
        dcterms:created "2026-11-18T14:38:42+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        dcterms:description "A refused comparison from the public consilience-ledger, under its rule set comparability-v0.1. Which claim does not state each condition, and the two values of a condition that differs, are read from the two claims' cards (claim A and claim B), whose receipts are in their own nanopublications. It records what the two claim cards, as extracted from their source sentences, allow; it is not a judgement of either paper." ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:ComparisonRefusal ;
        npx:introduces sub:refusal ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAsswIIF8a9__hit4OQs17fbfCjXPlc32hmREpFpl1Suw/templateVersion> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAKs5PfwzoDg8-lSMhdOHaqDeoFZOe-Mc_nOFfwI0B3xM/templateVersion> .
}

sub:assertion {
    sub:mismatch qudt:unit cv:MilliA-PER-CentiM2 ;
        cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:valueInClaimA 10.0 ;
        cv:valueInClaimB 100.0 .

    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "ref40_peng2023__002|ref40_peng2023__011" ;
        cv:axis cv:OperationalStabilityDuration ;
        cv:claimA <https://w3id.org/np/RA-wwFLLedctNlBcSNtQWif97OzFredyblCEDRMo6TmRU/claim> ;
        cv:claimASentence "After 500 h of testing at 10 mA cm–2, Pd-55 shows superior stability with little decay in 1 M HClO4." ;
        cv:claimB <https://w3id.org/np/RAwrBLENKiXnwhDiTib8_27psAe1kARtzKe0yzcfS_WeA/claim> ;
        cv:claimBSentence "Furthermore, the high durability of >40 h for Pd-55 at 100 mA cm–2 also confirms that hierarchical Pd is quite stable under a large current density." ;
        cv:hasConditionMismatch sub:mismatch ;
        cv:hasUnstatedCondition sub:unstated,
            sub:unstated__1,
            sub:unstated__2,
            sub:unstated__3,
            sub:unstated__4 ;
        cv:outcome cv:NotComparable .

    sub:unstated cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAwrBLENKiXnwhDiTib8_27psAe1kARtzKe0yzcfS_WeA/claim> .

    sub:unstated__1 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RA-wwFLLedctNlBcSNtQWif97OzFredyblCEDRMo6TmRU/claim> .

    sub:unstated__2 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RAwrBLENKiXnwhDiTib8_27psAe1kARtzKe0yzcfS_WeA/claim> .

    sub:unstated__3 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RA-wwFLLedctNlBcSNtQWif97OzFredyblCEDRMo6TmRU/claim> .

    sub:unstated__4 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RAwrBLENKiXnwhDiTib8_27psAe1kARtzKe0yzcfS_WeA/claim> .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

