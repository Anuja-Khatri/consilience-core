@prefix cv: <https://theconsilience.io/ns/cv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGeLFhSEHIg2vB1zUOMYE_Qga8e0WlC_pf3VBrGWDO34/> .
@prefix this: <https://w3id.org/np/RAGeLFhSEHIg2vB1zUOMYE_Qga8e0WlC_pf3VBrGWDO34> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L120-L159> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "d193bf09acd503c14ad66813bf7322dea3563930fa042e65bb575080421252d3" ;
        cv:exportedWith "consilience 0.1.1 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "card-sha256-v0" ;
        cv:ledgerHash "a11ee946669360b4327e2dd22391b2711cbba60c15e9f1f447286351abe69bdd" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Measured claim 2609.30133__004: RuOx, overpotential at a stated current density 0.41 V" ;
        dcterms:created "2026-11-18T14:38:09+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:MeasuredClaim ;
        npx:introduces sub:claim ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAsswIIF8a9__hit4OQs17fbfCjXPlc32hmREpFpl1Suw/templateVersion> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAcq68QGDna2fNM4nSvPs95YQFbYSC80fHUWxO4_wGFs0/templateVersion> .
}

sub:assertion {
    sub:categoricalCondition cv:condition cv:CurrentDensityNormalization ;
        cv:conditionValue cv:GeometricArea .

    sub:categoricalCondition__1 cv:condition cv:IRCorrection ;
        cv:conditionValue cv:NotIRCorrected .

    sub:claim a cv:MeasuredClaim ;
        dcterms:identifier "2609.30133__004" ;
        dcterms:source <https://arxiv.org/abs/2609.30133> ;
        cv:axis cv:OverpotentialAtCurrentDensity ;
        cv:claimKind cv:PerformanceValue ;
        cv:conditionUnstated cv:AnnealTemperature,
            cv:CatalystLoading,
            cv:Electrolyte,
            cv:PH,
            cv:PriorOperationDuration,
            cv:ProtocolTier,
            cv:Substrate,
            cv:Temperature ;
        cv:hasQuantity sub:quantity ;
        cv:measurability cv:MeasurableNow ;
        cv:measurableWith obo:CHMO_0000017 ;
        cv:sourceSentence "During the initial 10 mA cm-2 hold, InMnPdOx held a stable overpotential of 0.45 V (not iR-corrected), within 40 mV of RuOx (0.41 V) and roughly 90 mV below the best non-PGM catalyst." ;
        cv:statesCategoricalCondition sub:categoricalCondition,
            sub:categoricalCondition__1 ;
        cv:statesQuantityCondition sub:quantityCondition ;
        cv:subjectName "RuOx" .

    sub:quantity a qudt:QuantityValue ;
        qudt:numericValue 0.41 ;
        qudt:unit unit:V ;
        cv:bound cv:ExactValue ;
        cv:unitAsWritten "V" .

    sub:quantityCondition qudt:numericValue 10.0 ;
        qudt:unit cv:MilliA-PER-CentiM2 ;
        cv:condition cv:CurrentDensity .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

