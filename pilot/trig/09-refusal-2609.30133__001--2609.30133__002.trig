sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "2609.30133__001|2609.30133__002" ;
        cv:axis cv:HoursToThreshold ;
        cv:claimA <https://w3id.org/np/RACGvgVe-XqVcXhs3IuiRpRsHDPmmL8nUULjsAr4jGopU/claim> ;
        cv:claimASentence "During long-term testing, NiTaPdOx operated at lower overpotential than PdOx, but both eventually exceeded 0.5 V: PdOx at ~200 h and NiTaPdOx at ~470 h." ;
        cv:claimB <https://w3id.org/np/RAIPP1_TVgBpYlrl3GrwnCz80bDEZZc_m21FXLO9Nr7N4/claim> ;
        cv:claimBSentence "During long-term testing, NiTaPdOx operated at lower overpotential than PdOx, but both eventually exceeded 0.5 V: PdOx at ~200 h and NiTaPdOx at ~470 h." ;
        cv:hasUnstatedCondition sub:unstated,
            sub:unstated__1,
            sub:unstated__2,
            sub:unstated__3,
            sub:unstated__4,
            sub:unstated__5,
            sub:unstated__6,
            sub:unstated__7 ;
        cv:outcome cv:NotComparable .

    sub:unstated cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RACGvgVe-XqVcXhs3IuiRpRsHDPmmL8nUULjsAr4jGopU/claim> .

    sub:unstated__1 cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAIPP1_TVgBpYlrl3GrwnCz80bDEZZc_m21FXLO9Nr7N4/claim> .

    sub:unstated__2 cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:unstatedIn <https://w3id.org/np/RACGvgVe-XqVcXhs3IuiRpRsHDPmmL8nUULjsAr4jGopU/claim> .

    sub:unstated__3 cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:unstatedIn <https://w3id.org/np/RAIPP1_TVgBpYlrl3GrwnCz80bDEZZc_m21FXLO9Nr7N4/claim> .

    sub:unstated__4 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RACGvgVe-XqVcXhs3IuiRpRsHDPmmL8nUULjsAr4jGopU/claim> .

    sub:unstated__5 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RAIPP1_TVgBpYlrl3GrwnCz80bDEZZc_m21FXLO9Nr7N4/claim> .

    sub:unstated__6 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RACGvgVe-XqVcXhs3IuiRpRsHDPmmL8nUULjsAr4jGopU/claim> .

    sub:unstated__7 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RAIPP1_TVgBpYlrl3GrwnCz80bDEZZc_m21FXLO9Nr7N4/claim> .
}

