sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    sub:claim a cv:MeasuredClaim ;
        dcterms:identifier "ref40_peng2023__044" ;
        dcterms:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis cv:MassActivity ;
        cv:claimKind cv:PerformanceValue ;
        cv:conditionUnstated cv:AnnealTemperature,
            cv:CatalystLoading,
            cv:CurrentDensity,
            cv:Electrolyte,
            cv:IRCorrection,
            cv:PH,
            cv:PriorOperationDuration,
            cv:ProtocolTier,
            cv:Substrate,
            cv:Temperature ;
        cv:hasQuantity sub:quantity ;
        cv:measurability cv:MeasurableNow ;
        cv:measurableWith cv:RDEMassActivity ;
        cv:sourceSentence "The size effect was further evidenced by synthesizing ∼5.4 nm of Pd nanoparticles and obtaining a similar MA of 34.6 A g–1 to that of Pd-40 (∼5.8 nm-sized Pd nanoparticles) as revealed in Supplementary Fig. S13." ;
        cv:subjectName "Pd nanoparticles (~5.4 nm)" .

    sub:quantity a qudt:QuantityValue ;
        qudt:numericValue 34.6 ;
        qudt:unit unit:A-PER-GM ;
        cv:bound cv:ExactValue ;
        cv:unitAsWritten "A/g" .
}

