sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "2609.30133__003|ref40_peng2023__013" ;
        cv:axis cv:OverpotentialAtCurrentDensity ;
        cv:claimA <https://w3id.org/np/RAts0acUjDGEa2bpHZ4p6K4uA8CoJwQI-3i3pTI6AktWE/claim> ;
        cv:claimASentence "During the initial 10 mA cm-2 hold, InMnPdOx held a stable overpotential of 0.45 V (not iR-corrected), within 40 mV of RuOx (0.41 V) and roughly 90 mV below the best non-PGM catalyst." ;
        cv:claimB <https://w3id.org/np/RA8Cv0LXELNkuYr36peGb3odESK3zqKEnZ-BHHjl60djs/claim> ;
        cv:claimBSentence "In contrast, the PdCoO2 precursors without etching display poor catalytic activity with an overpotential of 528 mV (Supplementary Fig. S9b)." ;
        cv:hasUnstatedCondition sub:unstated,
            sub:unstated__1,
            sub:unstated__2,
            sub:unstated__3,
            sub:unstated__4,
            sub:unstated__5 ;
        cv:outcome cv:NotComparable .

    sub:unstated cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAts0acUjDGEa2bpHZ4p6K4uA8CoJwQI-3i3pTI6AktWE/claim> .

    sub:unstated__1 cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RA8Cv0LXELNkuYr36peGb3odESK3zqKEnZ-BHHjl60djs/claim> .

    sub:unstated__2 cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:unstatedIn <https://w3id.org/np/RA8Cv0LXELNkuYr36peGb3odESK3zqKEnZ-BHHjl60djs/claim> .

    sub:unstated__3 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RAts0acUjDGEa2bpHZ4p6K4uA8CoJwQI-3i3pTI6AktWE/claim> .

    sub:unstated__4 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RA8Cv0LXELNkuYr36peGb3odESK3zqKEnZ-BHHjl60djs/claim> .

    sub:unstated__5 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RA8Cv0LXELNkuYr36peGb3odESK3zqKEnZ-BHHjl60djs/claim> .
}

