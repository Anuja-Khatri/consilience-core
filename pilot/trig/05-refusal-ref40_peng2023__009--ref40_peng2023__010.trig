sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/rejections.json#L10822-L10852> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "536e5dc117bb714892cc03fe2e9d6ca6c34d41f6f2df4a3edacb5a5a937be3f3" ;
        cv:exportedWith "consilience 0.1.1 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:assertion {
    sub:mismatch qudt:unit unit:A-PER-CentiM2 ;
        cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:valueInClaimA 1.0 ;
        cv:valueInClaimB 2.0 .

    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "ref40_peng2023__009|ref40_peng2023__010" ;
        cv:axis cv:CellVoltageAtCurrentDensity ;
        cv:claimA <https://w3id.org/np/RAYjDglVZBgAnaAuVzkH4u_fN_Cscue18BYFy8J2tINyU/claim> ;
        cv:claimASentence "From the polarization curves at 65°C in Fig. 5b and Supplementary Figs S16 and S17, a voltage of only 1.664 and 1.771 V is required to achieve 1 and 2 A cm–2, respectively, demonstrating superior performance for acidic water electrolysis [10,42]." ;
        cv:claimB <https://w3id.org/np/RAr3lUesJyhcWYp1NMfQ-rokWZP76fe5ZX7cAtyWtVD9k/claim> ;
        cv:claimBSentence "From the polarization curves at 65°C in Fig. 5b and Supplementary Figs S16 and S17, a voltage of only 1.664 and 1.771 V is required to achieve 1 and 2 A cm–2, respectively, demonstrating superior performance for acidic water electrolysis [10,42]." ;
        cv:hasConditionMismatch sub:mismatch ;
        cv:hasUnstatedCondition sub:unstated,
            sub:unstated__1,
            sub:unstated__2,
            sub:unstated__3 ;
        cv:outcome cv:NotComparable .

    sub:unstated cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAYjDglVZBgAnaAuVzkH4u_fN_Cscue18BYFy8J2tINyU/claim> .

    sub:unstated__1 cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAr3lUesJyhcWYp1NMfQ-rokWZP76fe5ZX7cAtyWtVD9k/claim> .

    sub:unstated__2 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RAYjDglVZBgAnaAuVzkH4u_fN_Cscue18BYFy8J2tINyU/claim> .

    sub:unstated__3 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RAr3lUesJyhcWYp1NMfQ-rokWZP76fe5ZX7cAtyWtVD9k/claim> .
}

