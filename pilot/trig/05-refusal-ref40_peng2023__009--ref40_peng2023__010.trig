sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "ref40_peng2023__009|ref40_peng2023__010" ;
        cv:axis "cell_voltage_at_current_density" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L741-L783> ;
        cv:claimASentence "From the polarization curves at 65°C in Fig. 5b and Supplementary Figs S16 and S17, a voltage of only 1.664 and 1.771 V is required to achieve 1 and 2 A cm–2, respectively, demonstrating superior performance for acidic water electrolysis [10,42]." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L784-L826> ;
        cv:claimBSentence "From the polarization curves at 65°C in Fig. 5b and Supplementary Figs S16 and S17, a voltage of only 1.664 and 1.771 V is required to achieve 1 and 2 A cm–2, respectively, demonstrating superior performance for acidic water electrolysis [10,42]." ;
        cv:hasDefect sub:defect,
            sub:defect__1,
            sub:defect__2 ;
        cv:outcome cv:NotComparable .

    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "CR2" ;
        cv:defectType cv:ConditionMismatch .

    sub:defect__2 cv:defectTarget "ir_correction" ;
        cv:defectType cv:ConditionUnstated .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

