sub:assertion {
    sub:claim a cv:MeasuredClaim ;
        dcterms:identifier "ref40_peng2023__013" ;
        dcterms:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis cv:OverpotentialAtCurrentDensity ;
        cv:claimKind cv:PerformanceValue ;
        cv:conditionUnstated cv:AnnealTemperature,
            cv:CatalystLoading,
            cv:CurrentDensity,
            cv:Electrolyte,
            cv:IRCorrection,
            cv:PH,
            cv:PriorOperationDuration,
            cv:ProtocolTier,
            cv:Substrate,
            cv:Temperature ;
        cv:hasQuantity sub:quantity ;
        cv:measurability cv:MeasurableNow ;
        cv:measurableWith obo:CHMO_0000017 ;
        cv:sourceSentence "In contrast, the PdCoO2 precursors without etching display poor catalytic activity with an overpotential of 528 mV (Supplementary Fig. S9b)." ;
        cv:subjectName "PdCoO2 precursor (without etching)" .

    sub:quantity a qudt:QuantityValue ;
        qudt:numericValue 528.0 ;
        qudt:unit unit:MilliV ;
        cv:bound cv:ExactValue ;
        cv:unitAsWritten "mV" .
}

