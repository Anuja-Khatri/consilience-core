@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    sub:claim a cv:MeasuredClaim ;
        dcterms:identifier "ref40_peng2023__009" ;
        dcterms:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis cv:CellVoltageAtCurrentDensity ;
        cv:claimKind cv:PerformanceValue ;
        cv:conditionUnstated cv:AnnealTemperature,
            cv:CatalystLoading,
            cv:Electrolyte,
            cv:IRCorrection,
            cv:PH,
            cv:PriorOperationDuration,
            cv:ProtocolTier,
            cv:Substrate ;
        cv:hasQuantity sub:quantity ;
        cv:measurability cv:MeasurableNow ;
        cv:measurableWith cv:PolarizationCurve ;
        cv:sourceSentence "From the polarization curves at 65°C in Fig. 5b and Supplementary Figs S16 and S17, a voltage of only 1.664 and 1.771 V is required to achieve 1 and 2 A cm–2, respectively, demonstrating superior performance for acidic water electrolysis [10,42]." ;
        cv:statesCategoricalCondition sub:categoricalCondition ;
        cv:statesQuantityCondition sub:quantityCondition,
            sub:quantityCondition__1 ;
        cv:subjectName "PEM electrolyser with Pd-55 (2 mg cm–2) as both cathode and anode catalysts" .

    sub:categoricalCondition cv:condition cv:CurrentDensityNormalization ;
        cv:conditionValue cv:GeometricArea .

    sub:quantity a qudt:QuantityValue ;
        qudt:numericValue 1.664 ;
        qudt:unit unit:V ;
        cv:bound cv:ExactValue ;
        cv:unitAsWritten "V" .

    sub:quantityCondition qudt:numericValue 1.0 ;
        qudt:unit unit:A-PER-CentiM2 ;
        cv:condition cv:CurrentDensity .

    sub:quantityCondition__1 qudt:numericValue 65.0 ;
        qudt:unit unit:DEG_C ;
        cv:condition cv:Temperature .
}

