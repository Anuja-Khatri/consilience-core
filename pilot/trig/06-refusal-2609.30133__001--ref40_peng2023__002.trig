        cv:exportedWith "consilience 0.1.1 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Comparison refused, 2609.30133__001 vs ref40_peng2023__002: different quantity axes (time to a potential threshold vs operational stability duration)" ;
        dcterms:created "2026-11-18T14:38:46+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        dcterms:description "A refused comparison from the public consilience-ledger, under its rule set comparability-v0.1. Which claim does not state each condition, and the two values of a condition that differs, are read from the two claims' cards (claim A and claim B), whose receipts are in their own nanopublications. It records what the two claim cards, as extracted from their source sentences, allow; it is not a judgement of either paper." ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:ComparisonRefusal ;
        npx:introduces sub:refusal ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAsswIIF8a9__hit4OQs17fbfCjXPlc32hmREpFpl1Suw/templateVersion> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAKs5PfwzoDg8-lSMhdOHaqDeoFZOe-Mc_nOFfwI0B3xM/templateVersion> .
}

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "2609.30133__001|ref40_peng2023__002" ;
        cv:axisOfClaimA cv:HoursToThreshold ;
        cv:axisOfClaimB cv:OperationalStabilityDuration ;
        cv:claimA <https://w3id.org/np/RACGvgVe-XqVcXhs3IuiRpRsHDPmmL8nUULjsAr4jGopU/claim> ;
        cv:claimASentence "During long-term testing, NiTaPdOx operated at lower overpotential than PdOx, but both eventually exceeded 0.5 V: PdOx at ~200 h and NiTaPdOx at ~470 h." ;
        cv:claimB <https://w3id.org/np/RA-wwFLLedctNlBcSNtQWif97OzFredyblCEDRMo6TmRU/claim> ;
        cv:claimBSentence "After 500 h of testing at 10 mA cm–2, Pd-55 shows superior stability with little decay in 1 M HClO4." ;
        cv:outcome cv:AxisMismatch .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

