sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Comparison refused, ref40_peng2023__026 vs ref40_peng2023__044: not stated in either claim: electrolyte, current density, temperature, iR correction" ;
        dcterms:created "2026-11-18T14:38:54+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        dcterms:description "A refused comparison from the public consilience-ledger, under its rule set comparability-v0.1. Which claim does not state each condition, and the two values of a condition that differs, are read from the two claims' cards (claim A and claim B), whose receipts are in their own nanopublications. It records what the two claim cards, as extracted from their source sentences, allow; it is not a judgement of either paper." ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:ComparisonRefusal ;
        npx:introduces sub:refusal ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAsswIIF8a9__hit4OQs17fbfCjXPlc32hmREpFpl1Suw/templateVersion> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAKs5PfwzoDg8-lSMhdOHaqDeoFZOe-Mc_nOFfwI0B3xM/templateVersion> .
}

sub:assertion {
    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "ref40_peng2023__026|ref40_peng2023__044" ;
        cv:axis cv:MassActivity ;
        cv:claimA <https://w3id.org/np/RAhjxsxrrpeXT98NDzWkSR-FKOAMKqWrO7cql1KD-8bfc/claim> ;
        cv:claimASentence "Prominently, the OER performance of the Pd catalyst is dramatically enhanced and exhibits an ultralow overpotential of 196 mV at 10 mA cm–2 and high mass activity of 407.2 A g–1 at 1.53 VRHE (RHE, reversible hydrogen electrode) in 1 M HClO4 when the size shrinks to ∼2.8 nm." ;
        cv:claimB <https://w3id.org/np/RAxc8w8saVaDqxmZphu1CGc79phLEoWFYRp8RI4RVwmQk/claim> ;
        cv:claimBSentence "The size effect was further evidenced by synthesizing ∼5.4 nm of Pd nanoparticles and obtaining a similar MA of 34.6 A g–1 to that of Pd-40 (∼5.8 nm-sized Pd nanoparticles) as revealed in Supplementary Fig. S13." ;
        cv:hasUnstatedCondition sub:unstated,
            sub:unstated__1,
            sub:unstated__2,
            sub:unstated__3,
            sub:unstated__4,
            sub:unstated__5,
            sub:unstated__6,
            sub:unstated__7 ;
        cv:outcome cv:NotComparable .

    sub:unstated cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAhjxsxrrpeXT98NDzWkSR-FKOAMKqWrO7cql1KD-8bfc/claim> .

    sub:unstated__1 cv:condition cv:Electrolyte ;
        cv:rule "CR1" ;
        cv:unstatedIn <https://w3id.org/np/RAxc8w8saVaDqxmZphu1CGc79phLEoWFYRp8RI4RVwmQk/claim> .

    sub:unstated__2 cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:unstatedIn <https://w3id.org/np/RAhjxsxrrpeXT98NDzWkSR-FKOAMKqWrO7cql1KD-8bfc/claim> .

    sub:unstated__3 cv:condition cv:CurrentDensity ;
        cv:rule "CR2" ;
        cv:unstatedIn <https://w3id.org/np/RAxc8w8saVaDqxmZphu1CGc79phLEoWFYRp8RI4RVwmQk/claim> .

    sub:unstated__4 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RAhjxsxrrpeXT98NDzWkSR-FKOAMKqWrO7cql1KD-8bfc/claim> .

    sub:unstated__5 cv:condition cv:Temperature ;
        cv:rule "CR3" ;
        cv:unstatedIn <https://w3id.org/np/RAxc8w8saVaDqxmZphu1CGc79phLEoWFYRp8RI4RVwmQk/claim> .

    sub:unstated__6 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RAhjxsxrrpeXT98NDzWkSR-FKOAMKqWrO7cql1KD-8bfc/claim> .

    sub:unstated__7 cv:condition cv:IRCorrection ;
        cv:rule "CR4" ;
        cv:unstatedIn <https://w3id.org/np/RAxc8w8saVaDqxmZphu1CGc79phLEoWFYRp8RI4RVwmQk/claim> .
}

