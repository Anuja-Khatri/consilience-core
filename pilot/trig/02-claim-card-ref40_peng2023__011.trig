@prefix this: <https://w3id.org/np/RAwrBLENKiXnwhDiTib8_27psAe1kARtzKe0yzcfS_WeA> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    sub:claim a cv:MeasuredClaim ;
        dcterms:identifier "ref40_peng2023__011" ;
        dcterms:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis cv:OperationalStabilityDuration ;
        cv:claimKind cv:StabilityValue ;
        cv:conditionUnstated cv:AnnealTemperature,
            cv:CatalystLoading,
            cv:Electrolyte,
            cv:IRCorrection,
            cv:PH,
            cv:PriorOperationDuration,
            cv:ProtocolTier,
            cv:Substrate,
            cv:Temperature ;
        cv:hasQuantity sub:quantity ;
        cv:measurability cv:MeasurableNow ;
        cv:measurableWith obo:CHMO_0000017 ;
        cv:sourceSentence "Furthermore, the high durability of >40 h for Pd-55 at 100 mA cm–2 also confirms that hierarchical Pd is quite stable under a large current density." ;
        cv:statesCategoricalCondition sub:categoricalCondition ;
        cv:statesQuantityCondition sub:quantityCondition ;
        cv:subjectName "Pd-55" .

    sub:categoricalCondition cv:condition cv:CurrentDensityNormalization ;
        cv:conditionValue cv:GeometricArea .

    sub:quantity a qudt:QuantityValue ;
        qudt:numericValue 40.0 ;
        qudt:unit unit:HR ;
        cv:bound cv:LowerBound ;
        cv:unitAsWritten "h" .

    sub:quantityCondition qudt:numericValue 100.0 ;
        qudt:unit cv:MilliA-PER-CentiM2 ;
        cv:condition cv:CurrentDensity .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L827-L866> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "2230f435fe816a257d689ec4c9f9a786b257df301d34697029be09d29c316778" ;
        cv:exportedWith "consilience 0.1.1 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "card-sha256-v0" ;
        cv:ledgerHash "a11ee946669360b4327e2dd22391b2711cbba60c15e9f1f447286351abe69bdd" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Measured claim ref40_peng2023__011: Pd-55, operational stability duration 40 h (lower bound)" ;
        dcterms:created "2026-11-18T14:37:58+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
