@prefix cv: <https://theconsilience.io/ns/cv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXh6DBpPYbvyXrn4d8jdFXopnj6LxKizenDybqP8K6OY/> .
@prefix this: <https://w3id.org/np/RAXh6DBpPYbvyXrn4d8jdFXopnj6LxKizenDybqP8K6OY> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    sub:finding a cv:DataQualityFinding ;
        dcterms:description "Made-up example: 3 of 1,000 rows of a made-up dataset record a value above the instrument limit recorded in the same row." ;
        dcterms:identifier "example-1" ;
        cv:check "A measured value must not exceed the instrument limit recorded in the same row (made-up example)." ;
        cv:dataset <https://example.org/dataset/example-1> ;
        cv:recordsChecked 1000 ;
        cv:recordsFlagged 3 .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Example: Data-quality finding example-1: 3 of 1000 records flagged" ;
        dcterms:created "2026-11-18T14:39:13+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> ;
        dcterms:description "Example only: this nanopublication shows how the template is filled. Its data is made up, refers to no real claim or dataset, and is not a Consilience result." ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType npx:ExampleNanopub,
            cv:DataQualityFinding ;
        npx:introduces sub:finding ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAGu_lx4ptrUOQpfHV8UZOXcNTlGnCGKyAASAplz-oVWs/templateVersion> .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .
}

