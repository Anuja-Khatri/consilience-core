sub:assertion {
    <https://github.com/Anuja-Khatri/theconsilience-engine/blob/96ba4e435bd13718d36435cc3436d938d2d1f894/results/demo/files/iitxgnwt_judge.json#L640-L665> a cv:TheoryClaimCard ;
        dcterms:identifier "iit_t003" ;
        rdf:value "sustained_maintenance" ;
        cv:axis "temporal_profile" ;
        cv:claimStatement "IIT predicts that the duration of a conscious instant is definite and sustained over tens to hundreds of milliseconds, not transient or phasic, as required by the exclusion postulate governing the cause–effect structure of the PSC." ;
        cv:polarity "asserts" ;
        cv:restsOn sub:location,
            sub:location__1 ;
        cv:statementForm cv:ReviewedParaphrase ;
        cv:theory "IIT" .

    sub:location dcterms:source <https://doi.org/10.1038/nrn.2016.44> ;
        cv:pageLocator "p.3" .

    sub:location__1 dcterms:source <https://doi.org/10.1038/nrn.2016.44> ;
        cv:pageLocator "p.6" .
}

