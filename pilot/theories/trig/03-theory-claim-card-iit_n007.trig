sub:assertion {
    sub:claim a cv:TheoryClaim ;
        dcterms:identifier "iit_n007" ;
        cv:claimStatement "The PSC is a bounded complex of elements with maximal integrated information; elements outside this boundary (e.g., cerebellar neurons, peripheral sensory/motor pathways, basal ganglia loops) do not directly contribute to consciousness despite influencing cortical activity." ;
        cv:dimension cv:Locus ;
        cv:polarity cv:Asserts ;
        cv:position cv:MaximalIrreducibleComplex ;
        cv:restsOn sub:location,
            sub:location__1 ;
        cv:statementForm cv:ReviewedParaphrase ;
        cv:theory wd:Q6042884 .

    sub:location dcterms:source <https://doi.org/10.1038/nrn.2016.44> ;
        cv:pageLocator "p.9" .

    sub:location__1 dcterms:source <https://doi.org/10.1038/nrn.2016.44> ;
        cv:pageLocator "p.2" .
}

