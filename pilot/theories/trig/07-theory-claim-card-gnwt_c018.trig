    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RAQKzFFaKhdmfiZ2VPyzUhrplPf0E6vit1i1hsMWfiSHk/consilience-engine> .

    this: rdfs:label "Theory claim gnwt_c018 (GNWT): time course = late onset past a threshold" ;
        dcterms:created "2026-11-18T14:38:31+00:00"^^xsd:dateTime ;
