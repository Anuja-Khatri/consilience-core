sub:assertion {
    sub:claim a cv:TheoryClaim ;
        dcterms:identifier "gnwt_n013" ;
        cv:claimStatement "Conscious processing is serial and all-or-none: at any moment only one interpretation reaches consciousness, and access to one item prevents or delays conscious access to a competing item." ;
        cv:dimension cv:TemporalProfile ;
        cv:polarity cv:Asserts ;
        cv:position cv:SerialAllOrNone ;
        cv:restsOn sub:location ;
        cv:statementForm cv:ReviewedParaphrase ;
        cv:theory cv:GlobalNeuronalWorkspaceTheory .

    sub:location dcterms:source <https://doi.org/10.1007/978-3-030-54173-6_4> ;
        cv:pageLocator "p.6" .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

