sub:assertion {
    sub:disagreement a cv:Disagreement ;
        dcterms:identifier "iit_c025|gnwt_c008" ;
        cv:claimA <https://w3id.org/np/RAi76_ncq9y0gCjpthbm3eOrFi6OMZGajuOZj6BVEDFHI/claim> ;
        cv:claimB <https://w3id.org/np/RAWr9a-oouwf4WScdI6iNrR36-2Wr3yWnHaag4dhDyhFk/claim> ;
        cv:dimension cv:Connectivity ;
        cv:observable cv:ConnectivityMetrics ;
        cv:testability cv:TestableNow ;
        cv:testabilityReason "The demo's check rules this disagreement decidable now: both claims bear on a shared observable (connectivity metrics) that current methods measure. The demo names no specific instrument, so none is recorded." .
}

