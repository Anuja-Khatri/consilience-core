cv:AnnealTemperature a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "anneal temperature"@en ;
    rdfs:comment "The temperature at which the catalyst was annealed. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:Temperature .

cv:ApproximateValue a owl:NamedIndividual ;
    rdfs:label "approximate value"@en ;
    rdfs:comment "Bound: the value is stated as approximate (for example, \"about 470 h\")."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Asserts a owl:NamedIndividual ;
    rdfs:label "asserts"@en ;
    rdfs:comment "Polarity: the theory asserts the position."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:AxisMismatch a owl:NamedIndividual ;
    rdfs:label "different quantity axes"@en ;
    rdfs:comment "Outcome and defect type: the two claims are on different quantity axes."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:CVOrLSV a owl:NamedIndividual,
        cv:MeasurementTechnique ;
    rdfs:label "cyclic or linear-sweep voltammetry"@en ;
    rdfs:comment "Either cyclic voltammetry or linear-sweep voltammetry; the source does not say which. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    skos:narrowMatch obo:CHMO_0000025,
        obo:CHMO_0000028 .

cv:CatalystLoading a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "catalyst loading"@en ;
    rdfs:comment "The mass of catalyst per electrode area. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:CellVoltageAtCurrentDensity a owl:NamedIndividual,
        cv:QuantityAxis ;
    rdfs:label "cell voltage at a stated current density"@en ;
    rdfs:comment "The voltage of a whole electrolysis cell at a stated current density. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:Voltage .

cv:ClaimCard a owl:Class ;
    rdfs:label "claim card (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:MeasuredClaim."@en,
        "v1: the claim card identified by its GitHub line range."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:ComparisonRefusal a owl:Class ;
    rdfs:label "comparison refusal"@en ;
    rdfs:comment "A comparison between two claims that was refused, with each reason named: which condition is not stated in which claim, which condition differs and its two values, or which axes differ."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:ConditionMismatch a owl:NamedIndividual ;
    rdfs:label "condition differs"@en ;
    rdfs:comment "Defect type: a condition is stated in both claims with different values."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:ConditionUnstated a owl:NamedIndividual ;
    rdfs:label "condition not stated"@en ;
    rdfs:comment "Defect type: a condition the rule set requires is not stated in a claim."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Connectivity a owl:NamedIndividual,
        cv:CommitmentDimension ;
    rdfs:label "connectivity"@en ;
    rdfs:comment "What pattern of connections consciousness requires. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:ConnectivityMetrics a owl:NamedIndividual,
        cv:Observable ;
    rdfs:label "connectivity metrics"@en ;
    rdfs:comment "Measures of how brain regions are connected, structurally or functionally. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    skos:broadMatch wd:Q66812725 ;
    skos:relatedMatch wd:Q56711521 .

cv:CurrentDensity a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "current density"@en ;
    rdfs:comment "The current density at which the claim was measured. Comparability rule CR2. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:ElectricCurrentDensity .

cv:CurrentDensityNormalization a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "current-density normalisation"@en ;
    rdfs:comment "What area the current density is normalised to (geometric electrode area or electrochemically active surface area). Part of rule CR2. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:DataQualityFinding a owl:Class ;
    rdfs:label "data-quality finding"@en ;
    rdfs:comment "A check run over a dataset and how many records it flagged out of how many it checked. Credits the dataset; not a statement about its authors."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Denies a owl:NamedIndividual ;
    rdfs:label "denies"@en ;
    rdfs:comment "Polarity: the theory denies the position."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Disagreement a owl:Class ;
    rdfs:label "disagreement"@en ;
    rdfs:comment "Two claims take different values on the same dimension. Records the dimension, the observables and instruments that bear on it, and whether the disagreement is testable now, testable under a stated assumption, or not yet testable, with the reason."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Electrolyte a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "electrolyte"@en ;
    rdfs:comment "The electrolyte the claim was measured in; its value is a ChEBI entity. Comparability rule CR1, together with cv:ElectrolyteConcentration. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:ElectrolyteConcentration a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "electrolyte concentration"@en ;
    rdfs:comment "The concentration of the electrolyte. Part of rule CR1. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:AmountOfSubstanceConcentration .

cv:ExactValue a owl:NamedIndividual ;
    rdfs:label "exact value"@en ;
    rdfs:comment "Bound: the value is stated as exact."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:GeometricArea a owl:NamedIndividual ;
    rdfs:label "normalised to the geometric electrode area"@en ;
    rdfs:comment "Value of cv:CurrentDensityNormalization."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:GlobalNeuronalWorkspaceTheory a owl:NamedIndividual ;
    rdfs:label "Global Neuronal Workspace Theory (GNWT)"@en ;
    rdfs:comment "The theory of consciousness of Dehaene, Changeux and colleagues. Wikidata's 'Dehaene–Changeux model' item is a close match; 'Global Workspace Theory' is broader. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    skos:broadMatch wd:Q5570791 ;
    skos:closeMatch wd:Q5252204 .

cv:GlobalWorkspaceConnectivityRequired a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "global-workspace connectivity required"@en ;
    rdfs:comment "Connectivity: a functional global neuronal workspace is required. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:GradedCorrespondence a owl:Class ;
    rdfs:label "graded correspondence"@en ;
    rdfs:comment "Two claims judged to correspond at a grade on a four-rung ladder (rung 1 strongest, 4 weakest), with a ceiling stating what the grade does not license."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:GradualBuildup a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "gradual build-up"@en ;
    rdfs:comment "Time course: builds up gradually across cortical areas. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:HeterogeneousConnectivityRequired a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "heterogeneous connectivity required"@en ;
    rdfs:comment "Connectivity: diverse, specialised causal connections are required. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:HoursToThreshold a owl:NamedIndividual,
        cv:QuantityAxis ;
    rdfs:label "time to a potential threshold"@en ;
    rdfs:comment "How long a catalyst operated before its potential reached a stated threshold. A different axis from operational stability duration, though both are times. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:Time .

cv:IRCorrected a owl:NamedIndividual ;
    rdfs:label "iR-corrected"@en ;
    rdfs:comment "Value of cv:IRCorrection."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:IRCorrection a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "iR correction"@en ;
    rdfs:comment "Whether the reported potential is corrected for the ohmic (iR) drop. Comparability rule CR4. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:IgnitionSignature a owl:NamedIndividual,
        cv:Observable ;
    rdfs:label "ignition signature"@en ;
    rdfs:comment "A sudden, sustained, widespread rise of activity when content becomes conscious. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:IntrinsicNotBroadcast a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "intrinsic, not broadcast"@en ;
    rdfs:comment "Locus: intrinsic to the physical substrate, not a relay or global broadcast. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:LateOnsetThreshold a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "late onset past a threshold"@en ;
    rdfs:comment "Time course: a late (>300 ms) all-or-none onset. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Locus a owl:NamedIndividual,
        cv:CommitmentDimension ;
    rdfs:label "locus"@en ;
    rdfs:comment "Where consciousness is located (which system or brain regions). Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:LowerBound a owl:NamedIndividual ;
    rdfs:label "lower bound"@en ;
    rdfs:comment "Bound: the true value is at least this (for example, \">40 h\")."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:MassActivity a owl:NamedIndividual,
        cv:QuantityAxis ;
    rdfs:label "mass activity"@en ;
    rdfs:comment "Current per mass of catalyst. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:SpecificElectricCurrent .

cv:MaximalIrreducibleComplex a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "a bounded maximal irreducible complex"@en ;
    rdfs:comment "Locus: a bounded complex of elements with maximal integrated information. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:MeasurableNow a owl:NamedIndividual ;
    rdfs:label "measurable now"@en ;
    rdfs:comment "Measurability: the quantity can be measured with techniques that exist today."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:MeasuredClaim a owl:Class ;
    rdfs:label "measured claim"@en ;
    rdfs:comment "A claim that states a measured quantity on an axis, with its unit, the conditions stated for it and the conditions not stated."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    rdfs:subClassOf cv:Claim .

cv:MilliA-PER-CentiM2 a qudt:Unit ;
    rdfs:label "milliampere per square centimetre"@en ;
    qudt:conversionMultiplier 10.0 ;
    qudt:hasQuantityKind quantitykind:ElectricCurrentDensity ;
    rdfs:comment "mA/cm²: QUDT has A/cm² (unit:A-PER-CentiM2) but no mA/cm². One mA/cm² is 10 A/m² (the conversion multiplier to the SI unit)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:NotComparable a owl:NamedIndividual ;
    rdfs:label "not comparable"@en ;
    rdfs:comment "Outcome: the two claims cannot be compared under the rule set."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:NotIRCorrected a owl:NamedIndividual ;
    rdfs:label "not iR-corrected"@en ;
