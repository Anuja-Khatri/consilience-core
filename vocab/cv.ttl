    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:SerialAllOrNone a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "serial and all-or-none"@en ;
    rdfs:comment "Time course: one interpretation at a time reaches consciousness. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:SingleMaximalComplex a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "a single maximal complex"@en ;
    rdfs:comment "Locus: one maximally irreducible system, not any subset or superset. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:StabilityValue a owl:NamedIndividual ;
    rdfs:label "stability value"@en ;
    rdfs:comment "Claim kind: a measured stability figure. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Substrate a owl:NamedIndividual,
