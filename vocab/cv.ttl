    rdfs:comment "Which tier of a stated testing protocol was followed. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:QuantityRefused a owl:NamedIndividual ;
    rdfs:label "quantity could not be read"@en ;
