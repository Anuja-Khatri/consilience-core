cv:PosteriorHotZone a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "a posterior cortical hot zone"@en ;
    rdfs:comment "Locus: posterior cortex rather than prefrontal regions. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:PrefrontalParietalCorticalNetwork a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "a prefrontal-parietal cortical network"@en ;
