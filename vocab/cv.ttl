        obo:UBERON_0001872 .

cv:PriorOperationDuration a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "prior operation duration"@en ;
    rdfs:comment "How long the catalyst had operated before the measurement. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:Time .

cv:ProtocolTier a owl:NamedIndividual,
