cv:RegionalDecoding a owl:NamedIndividual,
        cv:Observable ;
    rdfs:label "regional decoding"@en ;
    rdfs:comment "Decoding conscious content from the activity of particular brain regions. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
