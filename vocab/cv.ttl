    rdfs:label "operational stability duration"@en ;
    rdfs:comment "How long a catalyst operated stably in a test. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
