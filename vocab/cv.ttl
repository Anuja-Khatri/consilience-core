    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:SustainedMaintenance a owl:NamedIndividual,
        cv:TheoryPosition ;
    rdfs:label "sustained maintenance"@en ;
    rdfs:comment "Time course: sustained over tens to hundreds of milliseconds, not transient. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Temperature a owl:NamedIndividual,
        cv:ConditionType ;
    rdfs:label "temperature"@en ;
    rdfs:comment "The temperature of measurement. Comparability rule CR3. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    cv:quantityKind quantitykind:Temperature .

cv:TemporalGeneralization a owl:NamedIndividual,
        cv:Observable ;
    rdfs:label "temporal generalisation"@en ;
    rdfs:comment "Whether a decoder trained at one time point also decodes at others, which shows whether a representation is sustained. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:TemporalProfile a owl:NamedIndividual,
        cv:CommitmentDimension ;
    rdfs:label "time course"@en ;
    rdfs:comment "How conscious content unfolds in time. Used by the cross-theory demo's claim cards (consciousness science)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:TestableDisagreement a owl:Class ;
    rdfs:label "testable disagreement (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:Disagreement."@en,
        "v1: a disagreement said to be testable now with an instrument."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:TestableNow a owl:NamedIndividual ;
    rdfs:label "testable now"@en ;
    rdfs:comment "Testability: the disagreement can be tested with observables and instruments that exist today."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:TestableUnderAssumption a owl:NamedIndividual ;
    rdfs:label "testable under a stated assumption"@en ;
    rdfs:comment "Testability: the disagreement can be tested if the stated assumption holds."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:TheoryClaim a owl:Class ;
    rdfs:label "theory claim"@en ;
    rdfs:comment "A claim of a scientific theory: the position the theory takes on one dimension of commitment. It states no measured quantity."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    rdfs:subClassOf cv:Claim .

cv:TheoryClaimCard a owl:Class ;
    rdfs:label "theory claim card (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:TheoryClaim."@en,
        "v1: the theory claim card identified by its GitHub line range."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:TypeMismatch a owl:NamedIndividual ;
    rdfs:label "different claim kinds"@en ;
    rdfs:comment "Defect type: the two claims are of different kinds."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:UpperBound a owl:NamedIndividual ;
    rdfs:label "upper bound"@en ;
    rdfs:comment "Bound: the true value is at most this."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:assumption a rdf:Property ;
    rdfs:label "under the assumption"@en ;
    rdfs:comment "The assumption under which a disagreement is testable."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:axis a rdf:Property ;
    rdfs:label "is on the quantity axis"@en ;
    rdfs:comment "The quantity axis (a cv:QuantityAxis) a measured claim's number is a value of."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:axisOfClaimA a rdf:Property ;
    rdfs:label "claim A is on the axis"@en ;
    rdfs:comment "A cv:QuantityAxis."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:axisOfClaimB a rdf:Property ;
    rdfs:label "claim B is on the axis"@en ;
    rdfs:comment "A cv:QuantityAxis."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:bound a rdf:Property ;
    rdfs:label "with bound"@en ;
    rdfs:comment "Whether the value is exact, approximate, a lower bound or an upper bound."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:canonicalUnit a rdf:Property ;
    rdfs:label "in the unit (v1)"@en ;
    rdfs:comment "Not used from v2 on; see qudt:unit."@en,
        "v1: a unit as a string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:check a rdf:Property ;
    rdfs:label "applies the check"@en ;
    rdfs:comment "The check, in plain words."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:claimA a rdf:Property ;
    rdfs:label "compares claim A"@en ;
    rdfs:comment "Claim A: a claim IRI."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:claimASentence a rdf:Property ;
    rdfs:label "claim A's source sentence"@en ;
    rdfs:comment "Copied for readability."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:claimB a rdf:Property ;
    rdfs:label "with claim B"@en ;
    rdfs:comment "Claim B: a claim IRI."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:claimBSentence a rdf:Property ;
    rdfs:label "claim B's source sentence"@en ;
    rdfs:comment "Copied for readability."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:claimKind a rdf:Property ;
    rdfs:label "is of claim kind"@en ;
    rdfs:comment "The kind of claim (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:claimStatement a rdf:Property ;
    rdfs:label "has the claim statement"@en ;
    rdfs:comment "The claim in words. For theory claims, a reviewed paraphrase, not a quotation."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:codeVersion a rdf:Property ;
    rdfs:label "was computed by the code version"@en ;
    rdfs:comment "A version string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:condition a rdf:Property ;
    rdfs:label "concerns the condition"@en ;
    rdfs:comment "Which condition (a cv:ConditionType) a node is about."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:conditionName a rdf:Property ;
    rdfs:label "has the condition name (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:condition."@en,
        "v1: a condition name as a string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:conditionUnstated a rdf:Property ;
    rdfs:label "does not state the condition"@en ;
    rdfs:comment "A condition (a cv:ConditionType) the claim's source sentence does not state."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:conditionValue a rdf:Property ;
    rdfs:label "has the condition value"@en ;
    rdfs:comment "The value of a categorical condition (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:conditionValueJson a rdf:Property ;
    rdfs:label "has the condition value as JSON (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:statesQuantityCondition and cv:statesCategoricalCondition."@en,
        "v1: a condition value as a JSON string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:contentHash a rdf:Property ;
    rdfs:label "has the content hash"@en ;
    rdfs:comment "SHA-256, hex."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:dataset a rdf:Property ;
    rdfs:label "concerns the dataset"@en ;
    rdfs:comment "A persistent link to the dataset."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:defectTarget a rdf:Property ;
    rdfs:label "concerns"@en ;
    rdfs:comment "What a defect of a kind with no more specific statement concerns, in words."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:defectType a rdf:Property ;
    rdfs:label "is of defect type"@en ;
    rdfs:comment "The kind of defect."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:dimension a rdf:Property ;
    rdfs:label "concerns the dimension"@en ;
    rdfs:comment "The dimension of commitment of a theory claim, or the dimension two claims disagree on (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:draftedBy a rdf:Property ;
    rdfs:label "was drafted by"@en ;
    rdfs:comment "What drafted the statement before review, in words (for example, \"a large language model\")."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:equivocation a rdf:Property ;
    rdfs:label "has the equivocation-check result"@en ;
    rdfs:comment "Whether the correspondence survives removing the vocabulary the two claims share."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:exportedWith a rdf:Property ;
    rdfs:label "was exported with"@en ;
    rdfs:comment "Exporter and version."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:floor a rdf:Property ;
    rdfs:label "beyond the floor"@en ;
    rdfs:comment "In the node's qudt:unit."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:grade a rdf:Property ;
    rdfs:label "has the grade"@en ;
    rdfs:comment "Rung 1 (strongest) to 4 (weakest)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:gradeCeiling a rdf:Property ;
    rdfs:label "with the ceiling"@en ;
    rdfs:comment "What the grade does not license."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:hasCondition a rdf:Property ;
    rdfs:label "states the condition (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:statesQuantityCondition and cv:statesCategoricalCondition."@en,
        "v1: a stated condition node."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:hasConditionMismatch a rdf:Property ;
    rdfs:label "is refused because a condition differs"@en ;
    rdfs:comment "A node naming the condition (cv:condition), the rule (cv:rule), the value in each claim (cv:valueInClaimA, cv:valueInClaimB) and their unit (qudt:unit)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:hasDefect a rdf:Property ;
    rdfs:label "has the defect"@en ;
    rdfs:comment "A defect of a kind with no more specific statement (cv:defectType, cv:defectTarget)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:hasQuantity a rdf:Property ;
    rdfs:label "states the quantity"@en ;
    rdfs:comment "The stated quantity (a qudt:QuantityValue with qudt:numericValue and qudt:unit)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:hasUnstatedCondition a rdf:Property ;
    rdfs:label "is refused because a condition is not stated"@en ;
    rdfs:comment "A node naming the condition (cv:condition), the claim that does not state it (cv:unstatedIn) and the rule that requires it (cv:rule). One node per claim: if both claims lack a condition, there are two."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:hashMethod a rdf:Property ;
    rdfs:label "hashed with the method"@en ;
    rdfs:comment "How the content hash is recomputed (see docs/VOCABULARY.md)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:instrument a rdf:Property ;
    rdfs:label "can be tested with the instrument"@en ;
    rdfs:comment "An instrument or technique (an IRI). Not an observable."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:ledgerHash a rdf:Property ;
    rdfs:label "is covered by the ledger hash"@en ;
    rdfs:comment "SHA-256, hex."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:mapVersion a rdf:Property ;
    rdfs:label "with the axis map version"@en ;
    rdfs:comment "A version string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:margin a rdf:Property ;
    rdfs:label "differs by the margin"@en ;
    rdfs:comment "In the node's qudt:unit."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:measurability a rdf:Property ;
    rdfs:label "has measurability"@en ;
    rdfs:comment "Whether the quantity can be measured today (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:measurableWith a rdf:Property ;
    rdfs:label "is measurable with the technique"@en ;
    rdfs:comment "A technique the quantity is measured with (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:objectName a rdf:Property ;
    rdfs:label "measures (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:axis."@en,
        "v1: what is measured, as a string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:observable a rdf:Property ;
    rdfs:label "bears on the observable"@en ;
    rdfs:comment "A cv:Observable or other IRI."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:outcome a rdf:Property ;
    rdfs:label "has the outcome"@en ;
    rdfs:comment "The outcome of a refused comparison."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:pageLocator a rdf:Property ;
    rdfs:label "at the page"@en ;
    rdfs:comment "A page of the PDF that was read, which can differ from the printed page number."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:polarity a rdf:Property ;
    rdfs:label "has the polarity"@en ;
    rdfs:comment "Asserts or denies (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:position a rdf:Property ;
    rdfs:label "takes the position"@en ;
    rdfs:comment "The position a theory claim takes on its dimension (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:quantityKind a rdf:Property ;
    rdfs:label "has the quantity kind"@en ;
    rdfs:comment "The QUDT quantity kind of an axis or condition."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:recordsChecked a rdf:Property ;
    rdfs:label "checked this many records"@en ;
    rdfs:comment "An integer."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:recordsFlagged a rdf:Property ;
    rdfs:label "flagged this many records"@en ;
    rdfs:comment "An integer."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:relation a rdf:Property ;
    rdfs:label "has the relation (v1)"@en ;
    rdfs:comment "Not used from v2 on; see cv:axis."@en,
        "v1: the relation, as a string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
    owl:deprecated true .

cv:restsOn a rdf:Property ;
    rdfs:label "rests on the source location"@en ;
    rdfs:comment "A source location (dct:source and cv:pageLocator) the claim rests on."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:reviewedBy a rdf:Property ;
    rdfs:label "was reviewed by"@en ;
    rdfs:comment "The person who reviewed the record's statement (an ORCID iD)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:rule a rdf:Property ;
    rdfs:label "under the rule"@en ;
    rdfs:comment "The identifier of a rule in the rule set named in the provenance (for example, CR2)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:rulesVersion a rdf:Property ;
    rdfs:label "under the rule version"@en ;
    rdfs:comment "A version string."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:sourceCommit a rdf:Property ;
    rdfs:label "at the commit"@en ;
    rdfs:comment "A full 40-hex commit."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:sourceRepository a rdf:Property ;
    rdfs:label "comes from the repository"@en ;
    rdfs:comment "A public repository."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:sourceSentence a rdf:Property ;
    rdfs:label "has the source sentence"@en ;
    rdfs:comment "The exact sentence of the source document the claim is extracted from."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:statementForm a rdf:Property ;
    rdfs:label "has a statement that is"@en ;
    rdfs:comment "What kind of text the claim statement is (for example, a reviewed paraphrase)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:statesCategoricalCondition a rdf:Property ;
    rdfs:label "states the categorical condition"@en ;
    rdfs:comment "A stated condition whose value is an IRI (cv:condition, cv:conditionValue), for example the electrolyte as a ChEBI entity."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:statesQuantityCondition a rdf:Property ;
    rdfs:label "states the quantitative condition"@en ;
    rdfs:comment "A stated condition with a number and a unit (cv:condition, qudt:numericValue, qudt:unit)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:subjectName a rdf:Property ;
    rdfs:label "is about the subject"@en ;
    rdfs:comment "What the claim is about (for example, a catalyst), as named in the source."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:testability a rdf:Property ;
    rdfs:label "has testability"@en ;
    rdfs:comment "Testable now, testable under a stated assumption, or not yet testable."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:testabilityReason a rdf:Property ;
    rdfs:label "for the reason"@en ;
    rdfs:comment "Why the testability is what it is."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:theory a rdf:Property ;
    rdfs:label "is a claim of the theory"@en ;
    rdfs:comment "The theory (an IRI)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:unitAsWritten a rdf:Property ;
    rdfs:label "has the unit as written"@en ;
    rdfs:comment "The unit exactly as the source wrote it, next to its qudt:unit IRI."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:unstatedIn a rdf:Property ;
    rdfs:label "is not stated in the claim"@en ;
    rdfs:comment "A claim IRI."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:valueInClaimA a rdf:Property ;
    rdfs:label "has in claim A the value"@en ;
    rdfs:comment "A number, in the node's qudt:unit."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:valueInClaimB a rdf:Property ;
    rdfs:label "has in claim B the value"@en ;
    rdfs:comment "A number, in the node's qudt:unit."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Claim a owl:Class ;
    rdfs:label "claim"@en ;
    rdfs:comment "A claim, identified by the IRI that its claim-card nanopublication introduces. The IRI stays the same when a corrected card supersedes the first one."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:CommitmentDimension a owl:Class ;
    rdfs:label "dimension of commitment"@en ;
    rdfs:comment "A dimension on which a theory commits to a position (for example, where consciousness is located). Not a quantity."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:MeasurementTechnique a owl:Class ;
    rdfs:label "measurement technique"@en ;
    rdfs:comment "A technique a quantity is measured with."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:Observable a owl:Class ;
    rdfs:label "observable"@en ;
    rdfs:comment "Something that can be measured and that a disagreement bears on (for example, regional decoding of conscious content). Not an instrument."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:QuantityAxis a owl:Class ;
    rdfs:label "quantity axis"@en ;
    rdfs:comment "What a measured claim's number is a value of (for example, the overpotential at a stated current density). Mapped to a QUDT quantity kind with cv:quantityKind."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:TheoryPosition a owl:Class ;
    rdfs:label "position of a theory"@en ;
    rdfs:comment "A position a theory's claim takes on a dimension of commitment."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

cv:ConditionType a owl:Class ;
    rdfs:label "condition"@en ;
    rdfs:comment "A condition under which a measured claim was made (for example, the electrolyte or the current density)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> .

<https://theconsilience.io/ns/cv> a owl:Ontology ;
    rdfs:label "Consilience verdict vocabulary (cv)" ;
    dct:creator <https://orcid.org/0009-0008-3375-7858> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Terms for Consilience records published as nanopublications: claims, refused comparisons, disagreements, receipts, and the axes, conditions, observables and positions the records refer to. Existing vocabularies (QUDT, ChEBI, CHMO, Wikidata, PROV-O, Dublin Core) are used directly where they fit; terms here map to them with SKOS where possible." .

