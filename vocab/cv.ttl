    rdfs:label "mass activity from rotating-disk-electrode measurements"@en ;
    rdfs:comment "Mass activity measured with a rotating-disk electrode. Used by the claim cards of the consilience-ledger (electrocatalysis)."@en ;
    rdfs:isDefinedBy <https://theconsilience.io/ns/cv> ;
