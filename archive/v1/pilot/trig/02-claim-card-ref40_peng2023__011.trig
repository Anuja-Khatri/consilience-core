    this: rdfs:label "Claim card ref40_peng2023__011: Pd-55, operational_stability_duration 40.0 h (bound: lower)" ;
        dcterms:created "2026-11-16T19:28:44+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
