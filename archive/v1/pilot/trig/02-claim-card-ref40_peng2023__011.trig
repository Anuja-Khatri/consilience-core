sub:assertion {
    <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L827-L866> a cv:ClaimCard ;
        dcterms:identifier "ref40_peng2023__011" ;
        dcterms:source <https://doi.org/10.1093/nsr/nwac108> ;
        cv:axis "operational_stability_duration" ;
        cv:claimKind "stability_value" ;
        cv:conditionUnstated "anneal_temperature",
            "electrolyte",
            "ir_correction",
            "loading",
            "ph",
            "prior_operation_duration",
            "protocol_tier",
            "substrate",
            "temperature" ;
        cv:hasCondition sub:condition ;
        cv:hasQuantity sub:quantity ;
        cv:measurability "measurable_now" ;
        cv:measurableWith "cp_chronopotentiometry" ;
        cv:objectName "stability_duration" ;
        cv:relation "has_stability_duration" ;
        cv:sourceSentence "Furthermore, the high durability of >40 h for Pd-55 at 100 mA cm–2 also confirms that hierarchical Pd is quite stable under a large current density." ;
        cv:subjectName "Pd-55" .

    sub:condition cv:conditionName "current_density" ;
        cv:conditionValueJson "{\"normalization\": \"geometric\", \"unit\": \"mA/cm^2\", \"value\": 100.0}" .

    sub:quantity a schema:QuantitativeValue ;
        schema:unitText "h" ;
        schema:value 40.0 ;
        cv:bound "lower" .
}

