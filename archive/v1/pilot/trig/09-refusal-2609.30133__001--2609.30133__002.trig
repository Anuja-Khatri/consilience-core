@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> .

    this: rdfs:label "Comparison refused, 2609.30133__001 vs 2609.30133__002: not stated: electrolyte, current_density, temperature, ir_correction" ;
        dcterms:created "2026-11-16T19:28:56+00:00"^^xsd:dateTime ;
        dcterms:creator <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType cv:ComparisonRefusal ;
        npx:introduces sub:refusal ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RAjkzVXYgeEW-ORY5ZYAa_l_mgd-3Ki7HFItomg2I8el4/templateVersion> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>,
            <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAr2wiuk3YGzyw123e9k0lc-c8Om_WRhv5zQEyP6Rz9Dw/templateVersion> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/np/RASIkcye4-dV2TVAUvTeacEPqwkEZuy3oAwgp6Tn12OGc/consilience-engine> ;
        prov:wasDerivedFrom <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/rejections.json#L2-L36> ;
        cv:codeVersion "lab-extension-0.1.0" ;
        cv:contentHash "5852b44eb3d8f3d46ec275faf5b2dfc16282286f8e9ff9ed2d7c79db9b3ed00f" ;
        cv:exportedWith "consilience 0.1.0.dev0 (github.com/Anuja-Khatri/consilience-core)" ;
        cv:hashMethod "verdict-sha256-v0" ;
        cv:mapVersion "materials_oer-v0" ;
        cv:rulesVersion "comparability-v0.1" ;
        cv:sourceCommit "7c1f9235b582666403537dd929c844e4b2dfc8cf" ;
        cv:sourceRepository <https://github.com/Anuja-Khatri/consilience-ledger> .
}

sub:assertion {
    sub:defect cv:defectTarget "electrolyte" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__1 cv:defectTarget "current_density" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__2 cv:defectTarget "temperature" ;
        cv:defectType cv:ConditionUnstated .

    sub:defect__3 cv:defectTarget "ir_correction" ;
        cv:defectType cv:ConditionUnstated .

    sub:refusal a cv:ComparisonRefusal ;
        dcterms:identifier "2609.30133__001|2609.30133__002" ;
        cv:axis "hours_to_threshold" ;
        cv:claimA <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L2-L40> ;
        cv:claimASentence "During long-term testing, NiTaPdOx operated at lower overpotential than PdOx, but both eventually exceeded 0.5 V: PdOx at ~200 h and NiTaPdOx at ~470 h." ;
        cv:claimB <https://github.com/Anuja-Khatri/consilience-ledger/blob/7c1f9235b582666403537dd929c844e4b2dfc8cf/ledger/claims.json#L41-L79> ;
        cv:claimBSentence "During long-term testing, NiTaPdOx operated at lower overpotential than PdOx, but both eventually exceeded 0.5 V: PdOx at ~200 h and NiTaPdOx at ~470 h." ;
        cv:hasDefect sub:defect,
            sub:defect__1,
            sub:defect__2,
            sub:defect__3 ;
        cv:outcome cv:NotComparable .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

