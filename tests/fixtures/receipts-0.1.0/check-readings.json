          "unit": "V"
        },
        "reading": {
          "plain_english": "The reading; its unit is given row by row in reading_unit.",
          "unit_column": "reading_unit"
        },
        "temperature_c": {
          "plain_english": null,
          "unit": "degC"
        }
      },
      "rules": [
        {
          "id": "R1",
          "kind": "limit",
          "column": "reading",
          "if_empty": "refuse",
          "plain_english": "A reading must not exceed its own recorded limit by more than 0.02 V.",
          "rationale": "A reading above the limit the instrument was set to is not a valid reading.",
          "source": null,
          "limit_column": "limit_v",
          "must_be": "at_most",
          "margin": "0.02 V",
          "value_offset": 0,
          "if_limit_empty": "refuse"
        },
        {
          "id": "R2",
          "kind": "bound",
          "column": "temperature_c",
          "if_empty": "refuse",
          "plain_english": "No temperature is below absolute zero.",
          "rationale": "Physically impossible; usually a sign or transcription error.",
          "source": null,
          "min": "0 K",
          "min_inclusive": true,
          "max_inclusive": true
        },
        {
          "id": "R3",
          "kind": "bound",
          "column": "humidity_pct",
          "if_empty": "refuse",
          "plain_english": "Relative humidity lies between 0 and 100 percent.",
          "rationale": "Physically impossible outside this range.",
          "source": null,
          "min": 0,
          "max": 100,
          "min_inclusive": true,
          "max_inclusive": true
        }
      ]
