      "name": "example-bench-readings",
      "version": "example-bench-readings-v1",
      "plain_english": "Example rules for a made-up table of bench readings: each reading must stay within its own recorded limit, temperatures cannot be below absolute zero, and relative humidity lies between 0 and 100 percent.",
      "rationale": null,
      "source": "Written for the consilience quickstart; the data it checks is made up.",
      "licence": null,
