sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    sub:claim a cv:TheoryClaim ;
        dcterms:identifier "gnwt_c003" ;
        cv:claimStatement "The locus of conscious processing is a large-scale prefrontal-parietal (and cingulate/temporal) cortical network, not posterior sensory cortices alone." ;
        cv:dimension cv:Locus ;
        cv:polarity cv:Asserts ;
        cv:position cv:PrefrontalParietalCorticalNetwork ;
        cv:restsOn sub:location,
            sub:location__1 ;
        cv:statementForm cv:ReviewedParaphrase ;
        cv:theory cv:GlobalNeuronalWorkspaceTheory .

    sub:location dcterms:source <https://doi.org/10.1016/j.neuron.2011.03.018> ;
        cv:pageLocator "p.1" .

    sub:location__1 dcterms:source <https://doi.org/10.1016/j.neuron.2011.03.018> ;
        cv:pageLocator "p.4" .
}

