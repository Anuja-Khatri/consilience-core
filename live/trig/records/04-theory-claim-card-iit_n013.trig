sub:assertion {
    sub:claim a cv:TheoryClaim ;
        dcterms:identifier "iit_n013" ;
        cv:claimStatement "Conscious information is not transmitted or broadcast from one brain region to another; the locus of consciousness is intrinsic to the PSC, not a relay or global broadcast." ;
        cv:dimension cv:Locus ;
        cv:polarity cv:Asserts ;
        cv:position cv:IntrinsicNotBroadcast ;
        cv:restsOn sub:location ;
        cv:statementForm cv:ReviewedParaphrase ;
        cv:theory wd:Q6042884 .

    sub:location dcterms:source <https://doi.org/10.1038/nrn.2016.44> ;
        cv:pageLocator "p.8" .
}

